pipeline {
    agent any

    // Ensure you have configured Maven and JDK in Jenkins (Manage Jenkins -> Global Tool Configuration)
    // The names here ('Maven 3' and 'JDK') must match the names you defined in Jenkins.
    tools {
        maven 'MVN'
        jdk 'JDk'
    }

    stages {
        stage('Checkout') {
            steps {
                // Checks out the code from the repository configured in the Jenkins Job
                checkout scm
            }
        }

        stage('Run Selenium Tests') {
            steps {
                echo 'Running Maven test suite...'
                
                // If your Jenkins server is on Windows, use 'bat'. 
                // If it is on Linux/Mac, change 'bat' to 'sh'.
                bat 'mvn clean test'
            }
        }
    }

    post {
        always {
            echo 'Archiving test results...'
            
            // Publish the JUnit/TestNG XML reports so Jenkins can generate a trend graph
            junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'
            
            // Archive the HTML reports and other artifacts generated by Surefire
            archiveArtifacts artifacts: 'target/surefire-reports/**/*', allowEmptyArchive: true
        }
        success {
            echo '✅ Test execution completed perfectly!'
        }
        failure {
            echo '❌ Some tests failed. Please review the Surefire reports.'
        }
    }
}
